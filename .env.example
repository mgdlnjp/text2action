# --- Fournisseur IA (côté serveur uniquement, jamais préfixé par VITE_) ---
# Laisser vide pour lancer l'application en MODE DÉMO (extraction par règles, aucun appel externe).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'extraction.
AI_MODEL=claude-opus-5-5

# Forcer le mode démo même si une clé est présente (true/false).
DEMO_MODE=false

# --- Serveur ---
PORT=8787
# Taille maximale du texte source accepté (caractères).
MAX_TEXT_CHARS=15000
# Nombre de requêtes d'extraction autorisées par IP et par minute.
RATE_LIMIT_PER_MINUTE=8
# Mettre à true si l'app est derrière un reverse proxy (Render, Fly, Nginx…) pour lire l'IP réelle.
TRUST_PROXY=false

# --- Abonnement Stripe (facultatif) ---
# Sans ces deux variables, la facturation est désactivée et l'outil reste en accès libre.
# Clé secrète : dashboard.stripe.com → Développeurs → Clés API (utilisez sk_test_… pour tester).
STRIPE_SECRET_KEY=
# Prix récurrent du forfait Pro : dashboard.stripe.com → Catalogue de produits (ex. 4,90 €/mois).
STRIPE_PRICE_ID=
# Secret de signature des jetons d'accès Pro, au moins 32 caractères : openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# URL publique de l'app pour les redirections Stripe (recommandé en production), sans / final.
APP_URL=
# Extractions gratuites par IP sur 24 h glissantes (quand Stripe est configuré).
FREE_EXTRACTIONS_PER_DAY=3
